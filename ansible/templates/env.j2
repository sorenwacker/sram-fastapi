# SRAM OIDC Configuration
SRAM_OIDC_CLIENT_ID={{ vault_sram_oidc_client_id }}
SRAM_OIDC_CLIENT_SECRET={{ vault_sram_oidc_client_secret }}
SRAM_OIDC_DISCOVERY_URL={{ sram_oidc_discovery_url }}

# SRAM Token Introspection (for application tokens)
{% if vault_sram_introspection_token is defined %}
SRAM_INTROSPECTION_TOKEN={{ vault_sram_introspection_token }}
{% endif %}
SRAM_INTROSPECTION_URL=https://sram.surf.nl/api/tokens/introspect

# SRAM organisation API (for collaboration management)
{% if vault_sram_organisation_api_token is defined %}
SRAM_ORGANISATION_API_TOKEN={{ vault_sram_organisation_api_token }}
{% endif %}
SRAM_API_BASE_URL={{ sram_api_base_url }}
SRAM_SERVICE_ENTITY_ID={{ sram_service_entity_id }}
COLLABORATION_MANAGER_ENTITLEMENT={{ collaboration_manager_entitlement }}
COLLABORATION_DELETION_ENABLED={{ collaboration_deletion_enabled }}

# Application settings
APP_NAME={{ app_name }}
DEBUG=false
SECRET_KEY={{ vault_secret_key }}

# Server settings
BASE_URL={{ base_url }}

# Session settings
SESSION_COOKIE_NAME={{ session_cookie_name }}
SESSION_MAX_AGE={{ session_max_age }}
SESSION_HTTPS_ONLY={{ session_https_only | default('true') }}
