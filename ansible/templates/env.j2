# SRAM OIDC Configuration
SRAM_OIDC_CLIENT_ID={{ vault_sram_oidc_client_id }}
SRAM_OIDC_CLIENT_SECRET={{ vault_sram_oidc_client_secret }}
SRAM_OIDC_DISCOVERY_URL={{ sram_oidc_discovery_url }}

# Application settings
APP_NAME={{ app_name }}
DEBUG=false
SECRET_KEY={{ vault_secret_key }}

# Server settings
BASE_URL={{ base_url }}

# Session settings
SESSION_COOKIE_NAME={{ session_cookie_name }}
SESSION_MAX_AGE={{ session_max_age }}
SESSION_HTTPS_ONLY={{ session_https_only | default('true') }}
