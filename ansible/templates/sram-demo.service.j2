[Unit]
Description=SRAM FastAPI Demo Application
After=network.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory={{ app_dir }}
Environment="PATH=/app/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile={{ app_dir }}/.env
ExecStart=/app/.local/bin/uv run gunicorn 'sram_fastapi.demo.app:get_demo_app()' -w {{ gunicorn_workers }} -k uvicorn.workers.UvicornWorker -b 127.0.0.1:{{ gunicorn_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
