# Production configuration for sram-demo.ewi.tudelft.nl

# SRAM OIDC Configuration (get these from SRAM)
SRAM_OIDC_CLIENT_ID=your-production-client-id
SRAM_OIDC_CLIENT_SECRET=your-production-client-secret
SRAM_OIDC_DISCOVERY_URL=https://proxy.sram.surf.nl/.well-known/openid-configuration

# Application settings
APP_NAME=SRAM Demo
DEBUG=false
SECRET_KEY=generate-a-secure-random-key-here

# Server settings
BASE_URL=https://sram-demo.ewi.tudelft.nl

# Session settings
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=3600
