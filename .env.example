# SRAM OIDC Configuration
SRAM_OIDC_CLIENT_ID=your-client-id
SRAM_OIDC_CLIENT_SECRET=your-client-secret
SRAM_OIDC_DISCOVERY_URL=https://proxy.sram.surf.nl/.well-known/openid-configuration

# SRAM Token Introspection (optional, for testing application tokens)
# Get this from your service configuration in SRAM under "User token introspection"
SRAM_INTROSPECTION_TOKEN=
SRAM_INTROSPECTION_URL=https://sram.surf.nl/api/tokens/introspect

# Application settings
APP_NAME=SRAM FastAPI
DEBUG=false
SECRET_KEY=generate-a-secure-random-key

# Server settings
BASE_URL=http://localhost:8124

# Session settings
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=3600
