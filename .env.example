# SRAM OIDC Configuration
SRAM_OIDC_CLIENT_ID=your-client-id
SRAM_OIDC_CLIENT_SECRET=your-client-secret
SRAM_OIDC_DISCOVERY_URL=https://proxy.sram.surf.nl/.well-known/openid-configuration

# SRAM Token Introspection (optional, for testing application tokens)
# Get this from your service configuration in SRAM under "User token introspection"
SRAM_INTROSPECTION_TOKEN=
SRAM_INTROSPECTION_URL=https://sram.surf.nl/api/tokens/introspect

# SRAM organisation API (optional, for collaboration management)
# Created by an organisation admin on the organisation's API tokens tab in SRAM
SRAM_ORGANISATION_API_TOKEN=
# Use https://acc.sram.surf.nl while testing
SRAM_API_BASE_URL=https://sram.surf.nl
# Entity ID of this service, needed to connect it to a collaboration
SRAM_SERVICE_ENTITY_ID=
# Entitlement required to provision and delete collaborations
COLLABORATION_MANAGER_ENTITLEMENT=
# Deleting a collaboration destroys its memberships and cannot be undone
COLLABORATION_DELETION_ENABLED=false

# Abbreviation of this service in SRAM, prefixed by SRAM to the groups it provisions
SRAM_SERVICE_ABBREVIATION=
# Features granted by SRAM group membership, as feature=group pairs. A group named on
# its own must be one of this service's own groups, so its short name starts with the
# abbreviation above, for example sramdemo-editors. Any other group is bound to the
# collaboration it belongs to: feature=tudelft:sramdemo/sramdemogroup
SRAM_FEATURE_GROUPS=

# Application settings
APP_NAME=SRAM FastAPI
DEBUG=false
SECRET_KEY=generate-a-secure-random-key

# Server settings
BASE_URL=http://localhost:8124

# Session settings
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=3600
